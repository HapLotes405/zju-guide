# 环境变量模板 — 复制为 .env 并填入真实值
# 注意：.env 文件绝不提交到 Git！

# 数据库
DATABASE_URL="postgresql://msewiki:msewiki@localhost:5432/msewiki"

# JWT 密钥（用 openssl rand -hex 32 生成）
JWT_SECRET="change-me-to-a-random-64-char-string"
JWT_REFRESH_SECRET="change-me-to-another-random-string"

# 应用
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# CC98（不需要单独的搜索key，直接跳转）
NEXT_PUBLIC_CC98_BASE_URL="https://www.cc98.org"
